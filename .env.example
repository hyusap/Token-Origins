# The default demo needs NO environment variables at all. Every value below has
# a working default; copy this file only if you want to override something.
# It starts an isolated localhost Anvil rehearsal and reads public RPCs.

ORIGINS_EXECUTION_MODE=local

# --- Chainlink Data Feeds (on-chain oracle reads) -------------------------
# Data Feeds are plain aggregator contracts, so reading them needs an RPC and
# NO Chainlink account or API key. (That is Data Streams, which this does not
# use.) Override only to use your own provider instead of the public node.
# ORIGINS_MAINNET_RPC=https://ethereum-rpc.publicnode.com

# --- Local backend / canvas ----------------------------------------------
# PORT=4318                                   # semantic backend port
# ORIGINS_BACKEND_URL=http://127.0.0.1:4318   # MCP server -> backend
# SOTTO_SERVER_URL=http://127.0.0.1:4318      # rehearsal bridge -> backend
# STATE_DB=.data/origins.sqlite               # canvas persistence
# DEPLOYMENT_FILE=.data/deployment.json       # vault deployment the backend reads

# --- Optional: real CRE execution with Sepolia broadcast ------------------
# Only needed to run the workflow on CRE rather than the local EVM rehearsal.
# Requires your own CRE account/API key and a funded testnet wallet.
# Never paste secrets into chat or commit this file with values filled in.
# API key authentication requires Chainlink account approval per current docs.
# ORIGINS_EXECUTION_MODE=cre
# CRE_API_KEY=
# CRE_ETH_PRIVATE_KEY=
# ORIGINS_SEPOLIA_VAULT=0xYourVaultDeployedWithSepoliaMockForwarder
# ORIGINS_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
