# Product execution authority is always Chainlink CRE. Never commit secret values.
ORIGINS_EXECUTION_MODE=cre

# Local canvas/API; no direct chain signer is started by bun run dev.
# PORT=4318
# ORIGINS_BACKEND_URL=http://127.0.0.1:4318
# WOGA_SERVER_URL=http://127.0.0.1:4318
# STATE_DB=.data/origins.sqlite

# Actual CRE CLI simulation and optional Sepolia broadcast.
# Authenticate using cre/bin/cre login or CRE_API_KEY.
# CRE_API_KEY=
# Fresh, funded Sepolia test wallet. It deploys and owns the vault and pays broadcast gas.
# CRE_ETH_PRIVATE_KEY=
# ORIGINS_CRE_DEPLOYMENT_FILE=contracts/deployment.sepolia.json
# Printed by: bun run deploy:sepolia (GrantVault v3: pause, sweep, pay, CCIP evacuate)
# ORIGINS_SEPOLIA_VAULT=0xYourVaultDeployedWithSepoliaMockForwarder
# ORIGINS_SEPOLIA_FORWARDER=0xYourVerifiedSepoliaSimulationForwarder
# ORIGINS_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# ORIGINS_CRE_GAS_LIMIT=2000000
# CRE project RPCs are configured separately in cre/project.yaml.
# Configuration is checked against the frozen target. No direct-signing fallback.

# Read-only canvas feed previews retain their explicit source network.
# ORIGINS_MAINNET_RPC=https://ethereum-rpc.publicnode.com

# Local audio recognition: bun run voice:setup. No hosted API key needed.
# Audio is deleted after each request; binary/model are retained under .data/voice.
# ORIGINS_VOICE_DATA_DIR=.data/voice

# Optional deploy-time settings (default: the deployer's own address / 0.01 ETH):
# ORIGINS_RESERVE_ADDRESS=      sweeps and CCIP evacuations go here
# ORIGINS_GRANTEE_ADDRESS=      payee "grantee"
# ORIGINS_INSURED_ADDRESS=      payee "insured"
# ORIGINS_VAULT_FUND_ETH=0.01

# Optional: the same CRE decision also pauses (or sweeps) the Solana vault (devnet).
# Create with: bun run solana:wallet (writes CRE_SOLANA_PRIVATE_KEY here, base58).
# CRE_SOLANA_PRIVATE_KEY=
# Printed by: bun run deploy:solana. `bun run solana:enable-sweep` lets it sweep to a reserve too.
# ORIGINS_SOLANA_VAULT=
# ORIGINS_SOLANA_RESERVE=       defaults to the vault owner
# ORIGINS_SOLANA_RPC=https://api.devnet.solana.com
